# szbolent-portal — 生产环境变量
# 部署到 www.szbolent.com.cn（企业备案 · 天翼云 14.29.216.219）时使用
#
# API 说明：VITE_LOOMA_API_BASE 留空 → 前端请求走同源 /v1/ → 由站点 nginx 反代，免 CORS
#   · 天翼线（nginx-tianyi-portal.conf）：/v1/ → 127.0.0.1:5203
#   · 阿里线（nginx.conf 门户入口）    ：/v1  → http://api.genz.ltd
# ⚠️ 天翼 Looma 宿主端口是 5203；本机开发仍是 5200（见 vite.config.ts / contracts/entry.json）
# ⚠️ 天翼云须先办「新增接入备案」（原接入商腾讯云）再切解析

VITE_SITE_URL=https://www.szbolent.com.cn
VITE_LOOMA_API_BASE=
VITE_BLOG_API_BASE=/wp-json/wp/v2
VITE_TATHA_POETRY_ENABLED=false

# 增长型门户 CTA
VITE_PLANETX_URL=https://app.genz.ltd
VITE_PLANETX_REF_CODE=
VITE_DEMOPPI_URL=
