# szbolent-portal — 生产环境变量
# 部署到 www.szbolent.com.cn（企业备案 · 腾讯云 1.14.202.161）时使用
#
# API 说明：VITE_LOOMA_API_BASE 留空 → 前端请求走同源 /v1/ → 由站点 nginx 反代，免 CORS
#   · 企业站（腾讯云 1.14.202.161，站点 szbolent-portal-tencent）：/v1/ → 127.0.0.1:5200
#   · 本机开发：vite proxy 直连（见 vite.config.ts / contracts/entry.json）
# ⚠️ 端口口径：腾讯云 / 本机 Looma = 5200；天翼 14.29.216.219 = 5203（勿混用）
# ⚠️ 天翼迁移方案（2026-09-11 方案 A）已废弃，见 nginx-tianyi-portal.conf 头部状态

VITE_SITE_URL=https://www.szbolent.com.cn
VITE_LOOMA_API_BASE=
VITE_BLOG_API_BASE=/wp-json/wp/v2
VITE_TATHA_POETRY_ENABLED=false

# 增长型门户 CTA
VITE_PLANETX_URL=https://app.genz.ltd
VITE_PLANETX_REF_CODE=
VITE_DEMOPPI_URL=
