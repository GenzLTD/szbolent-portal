#!/bin/sh
# [genz-guard] block direct pushes of main/master - use branch + PR (see MAINTAINERS.md)
block() {
  echo "[genz-guard] BLOCKED: direct push of main/master. Push a feature branch and open a PR."
  exit 1
}
# 1) standard pre-push contract: inspect ref update lines on stdin
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) block ;;
  esac
done
# 2) fallback for git builds that deliver empty stdin: block when pushing FROM main checkout
branch=$(git branch --show-current 2>/dev/null)
case "$branch" in
  main|master) block ;;
esac
exit 0

